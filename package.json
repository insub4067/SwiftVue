{
  "name": "swiftvue",
  "version": "0.4.0",
  "description": "SwiftUI-style component library for Vue.js — build web apps with familiar iOS syntax",
  "type": "module",
  "main": "./dist/swiftvue.umd.cjs",
  "module": "./dist/swiftvue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/swiftvue.js",
      "require": "./dist/swiftvue.umd.cjs"
    },
    "./styles": "./dist/swiftvue.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite serve playground",
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/ kitchen/",
    "lint:fix": "eslint src/ tests/ kitchen/ --fix",
    "check": "npm run typecheck && npm run lint && npm run test",
    "demo:build": "vite build playground",
    "demo:preview": "vite preview playground --port 4173 --strictPort",
    "e2e": "playwright test",
    "prepublishOnly": "npm run check && npm run verify:package",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "kitchen": "vite serve kitchen",
    "kitchen:build": "vite build kitchen",
    "kitchen:preview": "vite preview kitchen --port 4174 --strictPort"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  },
  "keywords": [
    "vue",
    "swiftui",
    "ios",
    "components",
    "ui-framework",
    "declarative",
    "vue3",
    "typescript",
    "accessibility"
  ],
  "license": "MIT",
  "author": "insub4067",
  "homepage": "https://insub4067.github.io/SwiftVue/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/insub4067/SwiftVue.git"
  },
  "bugs": {
    "url": "https://github.com/insub4067/SwiftVue/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
