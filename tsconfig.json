{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "declaration": true,
    "declarationDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@swiftvue": ["./src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts", "src/**/*.vue",
    "playground/**/*.ts", "playground/**/*.vue",
    "kitchen/**/*.ts", "kitchen/**/*.vue", "kitchen/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
